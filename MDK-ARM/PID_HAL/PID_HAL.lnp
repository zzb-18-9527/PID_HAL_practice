--cpu Cortex-M3
"pid_hal\startup_stm32f103xb.o"
"pid_hal\main.o"
"pid_hal\gpio.o"
"pid_hal\adc.o"
"pid_hal\dma.o"
"pid_hal\tim.o"
"pid_hal\usart.o"
"pid_hal\stm32f1xx_it.o"
"pid_hal\stm32f1xx_hal_msp.o"
"pid_hal\stm32f1xx_hal_gpio_ex.o"
"pid_hal\stm32f1xx_hal_adc.o"
"pid_hal\stm32f1xx_hal_adc_ex.o"
"pid_hal\stm32f1xx_hal.o"
"pid_hal\stm32f1xx_hal_rcc.o"
"pid_hal\stm32f1xx_hal_rcc_ex.o"
"pid_hal\stm32f1xx_hal_gpio.o"
"pid_hal\stm32f1xx_hal_dma.o"
"pid_hal\stm32f1xx_hal_cortex.o"
"pid_hal\stm32f1xx_hal_pwr.o"
"pid_hal\stm32f1xx_hal_flash.o"
"pid_hal\stm32f1xx_hal_flash_ex.o"
"pid_hal\stm32f1xx_hal_exti.o"
