"pid_hal\oled.o"
"pid_hal\oled_data.o"
--library_type=microlib --strict --scatter "PID_HAL\PID_HAL.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "PID_HAL.map" -o PID_HAL\PID_HAL.axf